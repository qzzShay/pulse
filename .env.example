# Datenbank: lokal eine SQLite-Datei, später z. B. Turso (libsql://…)
DATABASE_URL=file:./data/pulse.db
# Nur für Turso nötig
DATABASE_AUTH_TOKEN=

# Langer Zufallswert zum Signieren der Login-Sitzung (z. B. `openssl rand -hex 32`)
SESSION_SECRET=

# Öffentliche Adresse der Seite, ohne Schrägstrich am Ende
SITE_URL=http://localhost:3000
# Anzeigename der Plattform
BRAND=pulse

# Optional: Twitch-Live-Anzeige (kostenlos auf https://dev.twitch.tv/console → Anwendung registrieren)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
